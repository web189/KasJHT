rules_version = '2';

// Aturan Firestore untuk proyek "kasjht" — JHT KAS Adm PRG
//
// Model data: 3 dokumen di dalam koleksi "kas"
//   kas/members    -> { list: [ {id, nama, color, status, sejak, ...}, ... ] }
//   kas/transaksi  -> { list: [ {id, tgl, admin, shift, btb, bkb, ket, kat}, ... ] }
//   kas/requests   -> { list: [ {id, tgl, keterangan, nominal, mode, admins, status, ...}, ... ] }
//
// Model akses (sesuai fitur di README: tampilan tamu = lihat & ajukan
// pembelian, dashboard admin = kelola penuh):
//   - Siapa saja boleh MEMBACA ketiga dokumen (tampilan tamu bersifat transparan).
//   - "members" & "transaksi": dokumennya boleh DIBUAT siapa saja hanya kalau
//     BELUM ADA sama sekali (dipakai sekali di boot pertama untuk seeding data
//     awal dari kode). Setelah dokumen ada, mengUBAH/menghapus wajib admin
//     login (Firebase Authentication) — tamu tidak bisa mengubah kas/anggota.
//   - "requests" boleh ditulis oleh siapa saja, karena tamu memang boleh
//     mengajukan pembelian dari halaman publik. Admin (login) yang men-ACC/tolak
//     juga menulis ke dokumen yang sama.
//     Catatan keamanan: karena seluruh array pengajuan disimpan dalam SATU
//     dokumen, rule ini tidak bisa membedakan "menambah pengajuan baru" vs
//     "mengubah/menghapus pengajuan orang lain" hanya lewat Security Rules biasa.
//     Untuk aplikasi kas kelompok kecil yang saling percaya, ini cukup wajar.
//     Kalau ke depan butuh proteksi lebih ketat (mis. publik), pertimbangkan
//     restrukturisasi "requests" jadi 1 dokumen per pengajuan (sub-collection)
//     supaya create/update/delete bisa diberi rule terpisah.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    match /kas/members {
      allow read: if true;
      // Boleh dibuat siapa saja HANYA kalau dokumen belum ada (seed pertama kali
      // saat app dibuka pertama sebelum ada data). Setelah ada, ubah/hapus wajib admin.
      allow create: if !exists(/databases/$(database)/documents/kas/members);
      allow update, delete: if isAdmin();
    }

    match /kas/transaksi {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/kas/transaksi);
      allow update, delete: if isAdmin();
    }

    match /kas/requests {
      allow read: if true;
      allow write: if true; // tamu bisa mengajukan; admin mem-ACC/tolak
    }

    // Blokir semua koleksi/dokumen lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
